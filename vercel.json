{
  "framework": null,
  "installCommand": "echo HumanHub static preview",
  "buildCommand": "node scripts/build-sandbox.mjs",
  "outputDirectory": "sandbox-dist",
  "rewrites": [
    {
      "source": "/registro",
      "destination": "/acceso.html"
    },
    {
      "source": "/acceso",
      "destination": "/acceso.html"
    },
    {
      "source": "/educo",
      "destination": "/acceso.html"
    },
    {
      "source": "/educo/campo",
      "destination": "/acceso.html"
    },
    {
      "source": "/educo/coordinacion",
      "destination": "/acceso.html"
    },
    {
      "source": "/educo/mera",
      "destination": "/acceso.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://static.wixstatic.com; connect-src https://wakitroyztkypiadasyh.supabase.co; form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    },
    {
      "source": "/acceso",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/registro",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "/acceso",
      "permanent": false
    },
    {
      "source": "/demo.html",
      "destination": "/acceso",
      "permanent": false
    },
    {
      "source": "/demo/educo",
      "destination": "/educo",
      "permanent": false
    },
    {
      "source": "/demo/educo/campo",
      "destination": "/educo/campo",
      "permanent": false
    },
    {
      "source": "/demo/educo/coordinacion",
      "destination": "/educo/coordinacion",
      "permanent": false
    },
    {
      "source": "/demo/educo/mera",
      "destination": "/educo/mera",
      "permanent": false
    },
    {
      "source": "/educo/asistencia",
      "destination": "/acceso",
      "permanent": false
    },
    {
      "source": "/asistencia.html",
      "destination": "/acceso",
      "permanent": false
    },
    {
      "source": "/intelligence.html",
      "destination": "/acceso",
      "permanent": false
    },
    {
      "source": "/mera-legacy.html",
      "destination": "/acceso",
      "permanent": false
    }
  ]
}